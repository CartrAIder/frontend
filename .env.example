# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 커밋되지 않는다)
#   cp .env.example .env

# 백엔드 주소.
# 실기기(휴대폰)에서도 접속되도록 localhost 대신 맥의 LAN IP를 쓴다.
# 웹/시뮬레이터도 이 주소로 접속된다. IP가 바뀌면(다른 와이파이 등) 이 값을 갱신한다.
#   확인: ipconfig getifaddr en0
# 폰은 맥과 같은 와이파이여야 한다.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.2:8081

# 카트 연결·장바구니를 mock으로 돌릴지 여부.
# 실제 백엔드에 붙일 때는 반드시 false.
EXPO_PUBLIC_USE_MOCK=false
